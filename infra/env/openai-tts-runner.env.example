# openai-tts-runner — Kokoro TTS (/v1/audio/speech)
# Copy to .env and edit.

CAPABILITY_NAME=openai:audio-speech
MODEL_ALIAS=kokoro                           # identity.openai.model in the contract
MODEL_ID=hexgrad/Kokoro-82M
MODEL_DIR=/models
RUNNER_PORT=8080
DEVICE=cuda                                  # cuda | cpu
LANG_CODE=a                                  # a=American, b=British, ...
MAX_QUEUE_SIZE=5
MAX_INPUT_CHARS=4000
DEFAULT_VOICE=af_bella
METRICS_ENABLED=false
