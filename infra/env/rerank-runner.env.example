# rerank-runner — Cohere-compatible /v1/rerank
# Copy to .env and edit.

CAPABILITY_NAME=text:rerank
MODEL_ALIAS=zerank-2                         # identity.model in the contract (defaults to MODEL_ID minus the HF namespace)
MODEL_ID=zeroentropy/zerank-2
MODEL_DIR=/models
RUNNER_PORT=8080
DEVICE=cuda                                  # cuda | cpu
DTYPE=bfloat16
MAX_QUEUE_SIZE=5
MAX_BATCH_SIZE=1000
INFERENCE_BATCH_SIZE=64
METRICS_ENABLED=false
