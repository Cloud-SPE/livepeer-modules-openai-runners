# openai-image-generation-runner — Diffusers (/v1/images/generations)
# Copy to .env and edit.

CAPABILITY_NAME=openai:images-generations
MODEL_ID=                                    # required: HF diffusers model id (e.g. black-forest-labs/FLUX.1-dev)
MODEL_DIR=/models
RUNNER_PORT=8080
DEVICE=cuda                                  # cuda | cpu
DTYPE=float16
MAX_QUEUE_SIZE=5
USE_TORCH_COMPILE=false
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_STEPS=                               # model-dependent
DEFAULT_GUIDANCE=                            # model-dependent
METRICS_ENABLED=false
TRITON_CACHE_DIR=/cache/triton
