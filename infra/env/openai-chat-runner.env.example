# openai-chat-runner — streaming chat-completions proxy
# Copy to .env and edit. Required vars have no default; everything else is optional.

# --- core runtime -----------------------------------------------------------
RUNNER_ADDR=:8080
UPSTREAM_URL=http://vllm_chat:8000/v1/chat/completions
UPSTREAM_KIND=vllm                           # vllm | ollama | openai | dashscope
CAPABILITY_NAME=openai:chat-completions
USAGE_FIELD=total_tokens                     # prompt_tokens | completion_tokens | total_tokens
MODEL_DISCOVERY_RETRIES=10

# --- contract metadata (surfaced via GET /.well-known/livepeer-runner) ------
# All optional. SERVED_MODEL_NAME is identity.openai.model (one entry); unset
# means one entry per discovered model. The rest become x-* keys when set.
SERVED_MODEL_NAME=
BACKEND_MODEL=
CONTEXT_LENGTH=
REASONING_PARSER=
TOOL_CALL_PARSER=
QUANTIZATION=
