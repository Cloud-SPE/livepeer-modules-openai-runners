# openai-audio-runner — Whisper STT (/v1/audio/transcriptions + /v1/audio/translations)
# Copy to .env and edit.

CAPABILITY_NAME=                             # unset = openai:audio-transcriptions AND openai:audio-translations; set one to serve one
MODEL_ALIAS=whisper-large-v3                 # identity.openai.model in the contract (what callers put in "model")
MODEL_ID=openai/whisper-large-v3
MODEL_DIR=/models
RUNNER_PORT=8080
DEVICE=cuda                                  # cuda | cpu
DTYPE=bfloat16
MAX_QUEUE_SIZE=5
MAX_AUDIO_MB=50
CHUNK_LENGTH_S=30
INFERENCE_BATCH_SIZE=16
METRICS_ENABLED=false                        # true to expose /metrics
