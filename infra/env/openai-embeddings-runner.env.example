# openai-embeddings-runner — embeddings proxy
# Copy to .env and edit. Required vars have no default; everything else is optional.

# --- core runtime -----------------------------------------------------------
RUNNER_ADDR=:8080
UPSTREAM_URL=http://vllm_embeddings:8000/v1/embeddings
UPSTREAM_KIND=vllm                           # vllm | ollama
CAPABILITY_NAME=openai:embeddings
USAGE_FIELD=total_tokens                     # prompt_tokens | total_tokens
MODEL_DISCOVERY_RETRIES=10

# --- contract metadata (surfaced via GET /.well-known/livepeer-runner) ------
SERVED_MODEL_NAME=
BACKEND_MODEL=
EMBEDDING_DIMENSIONS=
MAX_INPUT_TOKENS=
POOLING_MODE=
