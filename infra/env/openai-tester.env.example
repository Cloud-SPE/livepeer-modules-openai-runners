# openai-tester — Node integration smoke harness
# Copy to .env and edit.
#
# OPENAI_API_KEY is REQUIRED. The image has no default — set it here.
# The runners themselves ignore the value (the broker handles auth upstream),
# so `local-dev-no-auth` is fine for local smoke; use a real key only when
# pointing the tester at a remote gateway via OPENAI_BASE_URL.

OPENAI_BASE_URL=http://localhost:8090/v1
OPENAI_API_KEY=local-dev-no-auth
MODEL=                                       # varies per test script
AUDIO_FILE=                                  # used by test-audio-transcription / -translation
