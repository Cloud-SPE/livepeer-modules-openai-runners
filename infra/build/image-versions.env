# Defaults the build scripts source. Override any of these in the environment.
# Bump here, not in the Dockerfiles: the ARG defaults there exist only so a
# bare `docker build` still works.
IMAGE_TAG_DEFAULT=v2.0.0

GO_VERSION=1.25.7
NODE_VERSION=22
PYTHON_VERSION=3.13
ALPINE_VERSION=3.20
UBUNTU_VERSION=24.04
CUDA_VERSION=13.2.1

# PyTorch wheel index for the four CUDA runners. cu128 wheels carry sm_75+
# kernels only; the -pascal flavor overrides this with cu126 (sm_50/60/70+).
PYTORCH_INDEX_URL_DEFAULT=https://download.pytorch.org/whl/cu128
